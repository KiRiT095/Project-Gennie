# Project Gennie — optional configuration
# Existing TUNA_* variables continue to work as fallbacks.
GENNIE_MODEL=qwen3:4b-instruct-2507-q4_K_M
GENNIE_OLLAMA_URL=http://127.0.0.1:11434
# Point this at your existing local database; do not commit credentials.
# GENNIE_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# Wake word: Sherpa-ONNX KWS model already downloaded locally.
GENNIE_WAKE_MODEL_DIR=models/wakeword/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01
GENNIE_KEYWORDS_FILE=models/wakeword/keywords.txt
GENNIE_WAKE_ENABLED=true
GENNIE_WAKE_THRESHOLD=0.22
# Leave blank to use the macOS default input device; or set a device index.
GENNIE_MIC_DEVICE=
GENNIE_IDLE_TIMEOUT_MS=45000

# Local Whisper.cpp English speech-to-text (run scripts/setup_voice.sh once).
GENNIE_WHISPER_MODEL=models/stt/ggml-small.en-q5_1.bin
# Voice activity detection: stop after silence, or cap each utterance.
GENNIE_VOICE_MAX_SECONDS=20
GENNIE_VOICE_END_SILENCE=1.15
GENNIE_VOICE_START_TIMEOUT=12

# macOS local speech output. Leave voice blank to auto-select a soft installed voice.
GENNIE_TTS_ENABLED=true
GENNIE_TTS_VOICE=
GENNIE_TTS_RATE=174
